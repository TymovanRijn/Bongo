# Voorbeeld van de instellingen. Kopieer dit bestand naar .env en vul het in:
#   cp .env.example .env
# .env staat in .gitignore: je sleutels en wachtwoorden komen nooit in git.
# Alles wat je leeg laat, krijgt de standaardwaarde uit assistent/config.py.

# ---- Claude ----------------------------------------------------------------
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=low
# CLAUDE_MAX_TOKENS=16000
# ASSISTENT_NAAM=Bongo
# GEBRUIKER_NAAM=Tymo
# TIJDZONE=Europe/Amsterdam

# ---- Opslag ----------------------------------------------------------------
# DATA_DIR=data

# ---- Agenda ----------------------------------------------------------------
# mock = een nep-agenda in data/mock_agenda.json, icloud = je echte agenda
CALENDAR_BACKEND=mock
# Apple ID en een app-specifiek wachtwoord (maken op account.apple.com)
# ICLOUD_USERNAME=
# ICLOUD_APP_PASSWORD=
# Naar welke agenda Bongo nieuwe afspraken schrijft
# ICLOUD_CALENDAR_NAME=
# Welke agenda's hij leest, met komma's ertussen (leeg = alle)
# ICLOUD_READ_CALENDARS=

# ---- Beslispunt 1: hoe lang onthoudt hij een gesprek? -----------------------
# stilte | laatste_n | samenvatten
# GESPREKSGEHEUGEN=stilte
# GESPREK_STILTE_MINUTEN=10
# GESPREK_MAX_BEURTEN=20

# ---- Kern en webapp (beslispunt 2) -----------------------------------------
# KERN_HOST=0.0.0.0
# KERN_POORT=8765
# open | pin | link
# WEB_TOEGANG=pin
# WEB_PIN=
# TAILSCALE_TOEGESTAAN=nee
# EXTRA_NETWERKEN=

# ---- Beslispunt 4: mag een hardop "ja" een voorstel goedkeuren? -------------
# STEM_BEVESTIGEN=nee

# ---- Beslispunt 5: ochtendoverzicht ----------------------------------------
# OCHTEND_TIJD=07:30
# OCHTEND_UITSPREKEN=nee

# ---- Scherm ----------------------------------------------------------------
# NACHT_VAN=23:00
# NACHT_TOT=07:00
# NACHT_SCHERM_UIT=nee
