# Voorbeeld van de instellingen. Kopieer dit bestand naar .env en vul het in:
#   cp .env.example .env
# .env staat in .gitignore: je sleutels en wachtwoorden komen nooit in git.
# Alles wat je leeg laat, krijgt de standaardwaarde uit assistent/config.py.

# ---- Claude ----------------------------------------------------------------
ANTHROPIC_API_KEY=
# Alleen nodig als je sleutel niet bij één workspace hoort (de foutmelding zegt dan
# "not scoped to a workspace"). Het id staat in de Anthropic Console bij Workspaces.
# ANTHROPIC_WORKSPACE_ID=wrkspc_...
# Welk model, en hoeveel nadenken (meet het verschil met: python -m assistent.meet)
# BONGO_MODEL=claude-sonnet-5-5
# BONGO_EFFORT=low
# adaptief | tussen_tools (tussen_tools = niet nadenken, kan alleen met claude-sonnet-5-5)
# BONGO_DENKEN=adaptief
# BONGO_MAX_TOKENS=16000
# ASSISTENT_NAAM=Bongo
# GEBRUIKER_NAAM=Tymo
# TIJDZONE=Europe/Amsterdam

# ---- Opslag ----------------------------------------------------------------
# DATA_DIR=data

# ---- Agenda ----------------------------------------------------------------
# mock = een nep-agenda in data/mock_agenda.json, icloud = je echte agenda
CALENDAR_BACKEND=mock
# Stap voor stap: docs/agenda.md
# Apple ID en een app-specifiek wachtwoord (maken op account.apple.com)
# ICLOUD_USERNAME=
# ICLOUD_APP_PASSWORD=
# De standaardagenda. Bongo kiest per afspraak zelf de agenda die past (een training in Sport);
# past er geen duidelijk, dan deze.
# ICLOUD_CALENDAR_NAME=Privé
# Agenda's die hij NIET leest (en waar hij dus ook niets in zet), met komma's ertussen
# ICLOUD_NIET_LEZEN=
# Of juist alleen deze agenda's lezen (leeg = alle)
# ICLOUD_READ_CALENDARS=
# Abonnementen (alleen lezen), zoals een lesrooster: naam=link, met komma's ertussen.
# Die zitten niet in iCloud's CalDAV. De link is persoonlijk: zet hem alleen hier, nergens anders.
# AGENDA_ABONNEMENTEN=Hogeschool=webcal://...

# ---- Beslispunt 1: hoe lang onthoudt hij een gesprek? -----------------------
# stilte | laatste_n | samenvatten
# GESPREKSGEHEUGEN=stilte
# GESPREK_STILTE_MINUTEN=10
# GESPREK_MAX_BEURTEN=20

# ---- Kern en webapp (beslispunt 2, zie docs/beslispunten.md) ---------------
# KERN_HOST=0.0.0.0
# KERN_POORT=8765
# pin = eerst een pincode, link = alleen met een koppellink, open = iedereen op het thuisnetwerk
# WEB_TOEGANG=pin
# Minstens 4 tekens, liefst 6 cijfers. Leeg = alleen het scherm van de Pi zelf kan bij Bongo.
WEB_PIN=
# TAILSCALE_TOEGESTAAN=nee
# Nog meer netwerken die erbij mogen, met komma's ertussen, bijvoorbeeld 203.0.113.0/24
# EXTRA_NETWERKEN=

# ---- Beslispunt 4: mag een hardop "ja" een voorstel goedkeuren? -------------
# STEM_BEVESTIGEN=nee

# ---- Beslispunt 5: ochtendoverzicht ----------------------------------------
# OCHTEND_TIJD=07:30
# OCHTEND_UITSPREKEN=nee

# ---- Spraak (fase 3, zie docs/spraak.md) ------------------------------------
# SPRAAK=aan
# Microfoon en luidspreker (ALSA-namen; "default" = wat PipeWire als standaard heeft)
# Voor de ReSpeaker Mic Array v2.0:
#   MIC_APPARAAT=plughw:CARD=ArrayUAC10,DEV=0
#   MIC_KANALEN=6      (of 1, zie docs/spraak.md)
#   MIC_KANAAL=0
#   SPEAKER_APPARAAT=plughw:CARD=ArrayUAC10,DEV=0
# MIC_APPARAAT=default
# MIC_KANALEN=1
# MIC_KANAAL=0
# SPEAKER_APPARAAT=default
# Whisper-model: tiny | base | small | medium (groter = beter verstaan, maar trager)
# STT_MODEL=small
# Piper-stem (op de Pi zelf); andere zien: .venv/bin/python -m piper.download_voices | grep nl_
# STEM=nl_NL-mls-medium
# Een natuurlijkere stem van Microsoft Azure, met Piper als reserve. Stap voor stap: docs/spraak.md
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGIO=westeurope
# AZURE_STEM=nl-NL-FennaNeural
# Wekwoord: leeg = uit (de microfoon gaat alleen aan als je op het gezicht tikt).
# Aan: de naam van een kant-en-klaar wekwoord (hey_jarvis, alexa, hey_mycroft, hey_rhasspy)
# of het pad naar een eigen model (.onnx). Zie docs/spraak.md, "Het wekwoord".
# WEKWOORD=hey_jarvis
# Hoe zeker hij moet zijn (0 tot 1). Hoger: minder vaak per ongeluk wakker, maar vaker niet gehoord.
# WEKWOORD_DREMPEL=0.5

# ---- Scherm ----------------------------------------------------------------
# NACHT_VAN=23:00
# NACHT_TOT=07:00
# NACHT_SCHERM_UIT=nee
